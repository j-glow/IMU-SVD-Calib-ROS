# Goal
# Number of distinct static poses to collect before running calibration.
# Both the SVD and Levenberg-Marquardt methods are run for comparison.
uint32 num_poses
---
# Result
bool success

# SVD (Rupniewski) results
float64[9] svd_calibration_matrix
float64[3] svd_bias_vector
float64 svd_rmse

# Levenberg-Marquardt baseline results
float64[9] lm_calibration_matrix
float64[3] lm_bias_vector
float64 lm_rmse
---
# Feedback
uint32 poses_collected
uint32 poses_needed
string status
